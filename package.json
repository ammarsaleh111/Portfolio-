{
  "name": "ammar-portfolio",
  "version": "2.0.0",
  "description": "Modern, accessible personal portfolio for Ammar Ahmed Saleh - Full-Stack Developer",
  "main": "index-enhanced.html",
  "scripts": {
    "dev": "live-server --port=8080 --open=index.html",
    "preview": "live-server --port=8080 --open=index.html --no-browser",
    "build:css": "cleancss -o style.min.css style-enhanced.css",
    "build:js": "terser scripts-enhanced.js -o scripts.min.js --compress --mangle",
    "build": "npm run build:css && npm run build:js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "lighthouse": "lighthouse http://localhost:8080 --view --output=html --output-path=./lighthouse-report.html",
    "validate:html": "html-validator --file=index-enhanced.html --format=text",
    "validate:css": "stylelint style-enhanced.css",
    "a11y": "pa11y http://localhost:8080 --reporter cli",
    "a11y:ci": "pa11y-ci --config .pa11yci.json"
  },
  "keywords": [
    "portfolio",
    "web-developer",
    "front-end",
    "full-stack",
    "react",
    "node",
    "accessibility",
    "wcag",
    "responsive"
  ],
  "author": {
    "name": "Ammar Ahmed Saleh",
    "email": "ammar@example.com",
    "url": "https://ammarahmedsaleh.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ammarsaleh111/portfolio"
  },
  "bugs": {
    "url": "https://github.com/ammarsaleh111/portfolio/issues"
  },
  "homepage": "https://ammarahmedsaleh.dev",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^24.10.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "iOS >= 14",
    "Android >= 90"
  ]
}
